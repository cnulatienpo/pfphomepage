/* ============================
   Spacing scale (8‑point)
   ============================ */
:root{
  --space-0: 0px;
  --space-1: 4px;   /* 0.5x */
  --space-2: 8px;   /* 1x   */
  --space-3: 12px;  /* 1.5x */
  --space-4: 16px;  /* 2x   */
  --space-5: 24px;  /* 3x   */
  --space-6: 32px;  /* 4x   */
  --space-7: 48px;  /* 6x   */
  --space-8: 64px;  /* 8x   */
  --space-9: 96px;  /* 12x  */
}

/* Pick a token with .space-N, then apply it with .p/.m/.gap, etc. */
.space-0 { --_s: var(--space-0); }
.space-1 { --_s: var(--space-1); }
.space-2 { --_s: var(--space-2); }
.space-3 { --_s: var(--space-3); }
.space-4 { --_s: var(--space-4); }
.space-5 { --_s: var(--space-5); }
.space-6 { --_s: var(--space-6); }
.space-7 { --_s: var(--space-7); }
.space-8 { --_s: var(--space-8); }
.space-9 { --_s: var(--space-9); }

/* Padding utilities */
.p  { padding: var(--_s, 0) !important; }
.px { padding-inline: var(--_s, 0) !important; }
.py { padding-block:  var(--_s, 0) !important; }
.pt { padding-top:    var(--_s, 0) !important; }
.pr { padding-right:  var(--_s, 0) !important; }
.pb { padding-bottom: var(--_s, 0) !important; }
.pl { padding-left:   var(--_s, 0) !important; }

/* Margin utilities */
.m  { margin: var(--_s, 0) !important; }
.mx { margin-inline: var(--_s, 0) !important; }
.my { margin-block:  var(--_s, 0) !important; }
.mt { margin-top:    var(--_s, 0) !important; }
.mr { margin-right:  var(--_s, 0) !important; }
.mb { margin-bottom: var(--_s, 0) !important; }
.ml { margin-left:   var(--_s, 0) !important; }

/* Negative margins (use sparingly) */
.m-neg  { margin:        calc(var(--_s, 0) * -1) !important; }
.mx-neg { margin-inline: calc(var(--_s, 0) * -1) !important; }
.my-neg { margin-block:  calc(var(--_s, 0) * -1) !important; }

/* Gap utility for Grid/Flex stacks */
.gap { gap: var(--_s, var(--space-3)); }
