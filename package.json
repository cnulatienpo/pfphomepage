{
  "name": "kill-line-theme-builder",
  "version": "0.1.0",
  "description": "Fisher-Price-style theme builder as a Windows app.",
  "main": "electron-main.js",
  "type": "module",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "postinstall": "node postinstall.js",
    "test": "node --test ./tests/*.js"
  },
  "dependencies": {
    "asciify-image": "^0.1.10",
    "cors": "^2.8.5",
    "css": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2",
    "osc-min": "^1.1.2",
    "postcss": "^8.5.6",
    "puppeteer": "^24.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "skia-canvas": "^3.0.0",
    "tsx": "^4.16.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "jsdom": "^23.2.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  },
  "build": {
    "appId": "com.killline.themebuilder",
    "productName": "Kill Line Theme Builder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "electron-main.js",
      "js/**/*",
      "css/**/*",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "KillLineThemeBuilder-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
